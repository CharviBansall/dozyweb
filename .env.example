# Stripe — prefer a restricted key (rk_…) over a secret key (sk_…) in production.
# Never commit real values. Create keys in a Stripe sandbox for development.
STRIPE_SECRET_KEY=rk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Recurring Price ID for Dozy Pro ($19/month). Create in Dashboard or CLI.
STRIPE_PRICE_ID=price_...

# Public site URL used for Checkout success/cancel + Customer Portal return.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs the dozy_entitlement session cookie. Falls back to STRIPE_SECRET_KEY if unset.
SESSION_SECRET=replace-with-long-random-string

# Junction (Vital) — cloud sleep sources (Oura / Garmin / Whoop).
# Dashboard: https://app.junction.com (or tryvital). Use Sandbox key first (sk_us_…).
JUNCTION_API_KEY=sk_us_...
JUNCTION_ENVIRONMENT=sandbox
# Optional once webhook signing is enabled in Dashboard.
JUNCTION_WEBHOOK_SECRET=

# /api/junction/* requires an app session (from POST /api/auth/apple) whenever
# JUNCTION_ENVIRONMENT=production. Set this to true to require it in sandbox too.
JUNCTION_REQUIRE_AUTH=false
# iOS bundle id that Sign in with Apple identity tokens are issued for (comma-separated if several).
APPLE_BUNDLE_ID=charvibansall.dozy
